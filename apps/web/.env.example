VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-publishable-key
VITE_API_URL=http://localhost:3000

# Mapbox (carte) — token public depuis https://account.mapbox.com
VITE_MAPBOX_TOKEN=pk.your-mapbox-public-token
# Style Mapbox personnalisé (Studio > Share > Style URL) ; défaut: dark-v11
VITE_MAPBOX_STYLE=mapbox://styles/your-username/your-style-id
