# The headers Cloudflare serves with the site's files, pages included (every
# path that is no file answers index.html, with the rules its path matches).
# The answers of /api/* come from the Worker and carry the API's own headers.
#
# The build writes dist/_headers from this file (vite.config.ts,
# src/shared/boot/csp.ts): it adds the content security policy to the `/*`
# block, and on staging the header that keeps the whole site out of search
# engines. The deploy then adds the cache rule of /map-data/*.
#
# Cloudflare keeps ONE block per path (a second block of the same path
# replaces the first) and applies the matching blocks in the file's order, so
# `/*` comes before the paths that change one of its headers.

# Built files carry a hash of their content in their name: a name never
# changes content, so the browser keeps them a year and never asks again.
# index.html (every path of the app) is not under /assets/ and keeps the
# default: asked again on each visit, so a release reaches the visitor.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Every file and every page. A file's type is the one announced; another site
# gets the site's address as referrer, never the page's path; no other site
# may show the pages in a frame, nor keep a handle on a window they open; the
# pages use no camera, microphone, position, payment or USB device; the
# browser comes back over HTTPS (one day for now, without the subdomains).
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=86400

# A witness's link holds their token in its path: the page sends no referrer
# at all (the rule of `/*` is taken off, then this one set), and stays out of
# search engines.
/verifier/*
  ! Referrer-Policy
  Referrer-Policy: no-referrer
  X-Robots-Tag: noindex

# The sign-in and administration pages stay out of search engines too.
/admin
  X-Robots-Tag: noindex
/admin/*
  X-Robots-Tag: noindex
/auth
  X-Robots-Tag: noindex
/auth/*
  X-Robots-Tag: noindex
/reset-password
  X-Robots-Tag: noindex
/reset-password/*
  X-Robots-Tag: noindex
