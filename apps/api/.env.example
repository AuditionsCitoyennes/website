# Where the API runs: local | staging | production. Anything but "local"
# behaves as production (no development shortcut); `npm run dev` sets local.
APP_ENV=local
# How emails leave: live (to their recipients) | outbox (not sent, kept for
# the site's test outbox: local and staging; refused in production) |
# redirect (to EMAIL_REDIRECT_TO, but for EMAIL_ALLOWLIST) | log (not sent, only logged).
# Default: live in production, log elsewhere. `npm run dev:local` sets outbox.
# EMAIL_MODE=log
# EMAIL_REDIRECT_TO=
# Redirect mode: recipients still reached directly (the testers), comma-separated
# addresses or @domain entries. Everyone else goes to EMAIL_REDIRECT_TO.
# EMAIL_ALLOWLIST=
# Supabase Auth's Send Email hook secret (v1,whsec_…): set, Auth's emails
# come through the API (/api/hooks/send-email). Secret.
# SEND_EMAIL_HOOK_SECRET=
# LOG_LEVEL=info

# Fastify API configuration
PORT=3000
WEB_ORIGIN=http://localhost:5173
# Public URL of the web app — used to build email verification links
PUBLIC_APP_URL=http://localhost:5173

# Supabase (reusing existing project nnnhefcdanzxsgnaletc)
SUPABASE_URL=https://nnnhefcdanzxsgnaletc.supabase.co
SUPABASE_ANON_KEY=sb_publishable_EVZYIaF7BFk5axbS5Dun1w__qdUXsR4

# Privileged secrets — NOT in the old repo. Get from Supabase dashboard / edge function secrets.
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
RESEND_API_KEY=your-resend-api-key

# The reverse proxy in front of the API, as a comma-separated list of IP
# addresses or CIDR ranges — in production the proxy's addresses (e.g.
# Cloudflare's published ranges, or the private network between the proxy and
# the container). Only X-Forwarded-* headers written by those addresses are
# believed, so the visitors' addresses (rate limits of the public "Témoigner"
# form) can't be spoofed. Leave empty when the API is reached directly.
TRUST_PROXY=
# Shared with the site's proxy (the Cloudflare Worker, apps/web/worker): with it,
# the visitor's address the Worker passes on (X-Visitor-IP) is believed. Secret,
# 32 characters at least; empty when there is no such proxy.
PROXY_SECRET=
# "true": only requests through that proxy are answered (plus /health and the
# Supabase Auth hook) — on staging, so that its gate covers the API too.
# REQUIRE_PROXY=false

# Where the geocode and boundary caches are kept on disk (a volume, in a
# container). Leave empty to keep them in apps/api, as always in development.
CACHE_DIR=
