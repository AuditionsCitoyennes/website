{
  "name": "@ac/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "APP_ENV=local tsx watch src/index.ts",
    "start": "node --enable-source-maps dist/index.js",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node24 --format=esm --packages=external --alias:@ac/shared=../../packages/shared/src/index.ts --sourcemap --outfile=dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/lib/cache.test.ts src/modules/geo/match.test.ts"
  },
  "dependencies": {
    "@ac/shared": "*",
    "@fastify/compress": "^9.1.0",
    "@fastify/cors": "^10.0.1",
    "@fastify/sensible": "^6.0.5",
    "@supabase/supabase-js": "^2.112.4",
    "dotenv": "^16.4.5",
    "fastify": "^5.12.6",
    "fastify-plugin": "^5.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "esbuild": "^0.28.1",
    "tsx": "^4.23.1",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=24"
  }
}
