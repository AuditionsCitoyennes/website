# Logs
*.log
npm-debug.log*

# Dependencies
node_modules

# Build output
dist
dist-ssr

# Environment files
.env
.env.*
!.env.example
# Test accounts written by local tooling
accounts.env

# Keys and certificates
key.txt
*.pem
*.key
id_rsa*
id_ed25519*
id_ecdsa*
supabase/signing_keys.json

# Database dumps and backups (docs/backups.md): a restore drill works outside
# the checkout, these are for the day one is run inside it, at its root.
# Migrations and seeds are under supabase/, which /*.sql leaves alone, as
# /restore/ and /backup/ leave alone a source folder of that name.
/restore/
/backup/
/prod-*.tar.gz
*.age
*.dump
/*.sql

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.local

# Supabase
supabase/.temp
supabase/.branches
# Generated by npm run db:seed (scripts/seed/)
supabase/seed.sql

# Server-side geocode cache (persisted BAN results; the filename is version-bumped)
.geocode-cache*.json

# The removed /api/boundaries disk cache: ignored so a stale local copy
# (≈ 40 MB) is never committed.
.boundaries-cache/
.boundaries-cache.json

# Claude Code (local settings, launch config)
.claude/
# Wrangler (Cloudflare) local state, and the files it reads local secrets
# from (secrets.env: the name the staging deploy gives its --secrets-file)
.wrangler/
.dev.vars
.dev.vars.*
secrets.env
# A local copy of the outline build (docs/map-outlines.md "Local development")
apps/web/public/map-data/
