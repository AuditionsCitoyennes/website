{
  "name": "auditions-citoyennes",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@ac/api & npm run dev --workspace=@ac/web",
    "dev:local": "tsx scripts/dev-local.ts",
    "dev:web": "npm run dev --workspace=@ac/web",
    "dev:api": "npm run dev --workspace=@ac/api",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:seed": "tsx scripts/seed/generate.ts",
    "db:reset": "tsx scripts/seed/generate.ts && supabase db reset",
    "db:accounts": "tsx scripts/seed/accounts.ts",
    "db:sql-gen": "tsx scripts/sql-gen/derived.ts",
    "build": "npm run build --workspace=@ac/web && npm run build --workspace=@ac/api",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p scripts",
    "lint": "eslint . && node apps/web/scripts/check-type-scale.mjs",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.11.1",
    "prettier": "^3.9.10"
  }
}
