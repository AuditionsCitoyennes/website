{
  "name": "auditions-citoyennes",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@ac/api & npm run dev --workspace=@ac/web",
    "dev:local": "tsx scripts/dev-local.ts",
    "dev:web": "npm run dev --workspace=@ac/web",
    "dev:api": "npm run dev --workspace=@ac/api",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:seed": "tsx scripts/seed/cli.ts",
    "db:reset": "tsx scripts/seed/cli.ts && supabase db reset",
    "db:accounts": "tsx scripts/seed/accounts.ts",
    "db:check": "tsx scripts/db-checks/index.ts",
    "db:check:seeded": "tsx scripts/db-checks/migrate-seeded.ts",
    "db:parity": "tsx scripts/parity/explore-parity.ts",
    "db:sql-gen": "tsx scripts/sql-gen/derived.ts",
    "test:scripts": "node --import tsx --test scripts/db-checks/seedGate.test.ts apps/web/src/features/geo/boundaries.test.ts apps/web/src/features/geo/treeFromUnits.test.ts apps/web/src/features/filters/serverFilters.test.ts apps/web/src/features/geo-nav/data/useUnitTree.test.ts apps/web/src/features/geo-nav/model/auditions.test.ts apps/web/src/features/geo-nav/data/resultsPages.test.ts apps/web/src/features/admin/auditions/contentMatches.test.ts apps/web/src/features/map/lib/outlineUpload.test.ts apps/web/src/features/map/plateau/lidTier.test.ts apps/web/src/shared/absoluteUrl.test.ts apps/web/src/features/map/dev/netKind.test.ts scripts/map-data/outlines/lib.test.ts scripts/map-data/outlines/outlines.fixture.test.ts apps/web/src/features/map/gl/meshConcat.test.ts apps/web/src/features/map/gl/meshDigest.test.ts apps/web/src/features/map/gl/globeDeferral.test.ts",
    "place-backfill": "tsx scripts/place-backfill/generate.ts",
    "build": "npm run build --workspace=@ac/web && npm run build --workspace=@ac/api",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p scripts",
    "lint": "eslint . && node apps/web/scripts/check-type-scale.mjs",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.12.0",
    "prettier": "^3.9.10"
  }
}
