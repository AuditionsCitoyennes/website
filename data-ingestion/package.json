{
  "name": "@ac/data-ingestion",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Ingestion pipeline for external open datasets of citizen-participation events",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "download": "tsx src/download.ts",
    "parse:gdn": "tsx src/parse_gdn.ts",
    "scrub": "tsx src/scrub_pii.ts",
    "geocode": "tsx src/geocode_qa.ts",
    "harvest:decidim": "tsx src/harvest_decidim.ts",
    "parse:participedia": "tsx src/parse_participedia.ts",
    "check:oecd": "tsx src/check_oecd.ts",
    "curate:gdn": "tsx src/curate_gdn.ts",
    "curate:gdn:apply": "tsx src/curate_gdn_apply.ts",
    "curate:gdn:redact:apply": "tsx src/curate_gdn_redact_apply.ts",
    "enrich:citycode": "tsx src/enrich_citycode.ts",
    "load:gdn": "tsx src/load_gdn_supabase.ts",
    "normalize": "tsx src/normalize.ts",
    "licenses": "tsx src/gen_licenses.ts",
    "pipeline:gdn": "npm run download && npm run parse:gdn && npm run scrub && npm run geocode && npm run normalize && npm run licenses",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dsnp/parquetjs": "^1.8.0",
    "csv-parse": "^7.0.3",
    "luxon": "^3.5.0",
    "yaml": "^2.7.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/luxon": "^3.4.2",
    "@types/node": "^22.20.0",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3",
    "vitest": "^5.0.5"
  }
}
